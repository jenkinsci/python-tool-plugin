<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Python Version}" field="version">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Configured Tool Name}" field="tool">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Virtual Environment Path / Directory}" field="venv">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Use Host / System Python}" field="system">
    <f:checkbox />
  </f:entry>
  <f:entry title="${%Custom Python Home Path}" field="home">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Custom Mirror Base URL}" field="mirrorUrl">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Enable CUDA Hardware Acceleration}" field="cuda">
    <f:checkbox />
  </f:entry>
  <f:entry title="${%Custom CUDA Home Path}" field="cudaHome">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Clear Virtualenv Before Creation}" field="clear">
    <f:checkbox />
  </f:entry>
  <f:entry title="${%Include System Site Packages}" field="systemSitePackages">
    <f:checkbox />
  </f:entry>
  <f:entry title="${%Enable Astral uv}" field="uv" description="${%Fast Rust-based package installer and resolver}">
    <f:checkbox default="true" />
  </f:entry>
  <f:entry title="${%Astral uv Version}" field="uvVersion" description="${%Optional Astral uv release version, defaults to latest}">
    <f:textbox default="latest" />
  </f:entry>
  <f:entry title="${%Custom Astral uv Mirror Base URL}" field="uvMirrorUrl" description="${%Optional custom mirror URL for Astral uv release binaries}">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Custom Astral uv Cache Directory}" field="uvCacheDir" description="${%Custom directory for UV_CACHE_DIR}">
    <f:textbox />
  </f:entry>
</j:jelly>
