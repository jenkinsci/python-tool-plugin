<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Python Version}" field="id">
    <f:select />
  </f:entry>
  <f:entry title="${%Custom Mirror Base URL}" field="mirrorUrl">
    <f:textbox />
  </f:entry>
  <f:optionalBlock title="${%Install Astral uv alongside Python}" field="installUv" inline="true">
    <f:entry title="${%Astral uv Version}" field="uvVersion" description="${%Astral uv release version to install alongside Python, defaults to latest}">
      <f:select default="latest" />
    </f:entry>
    <f:entry title="${%Custom Astral uv Mirror Base URL}" field="uvMirrorUrl" description="${%Optional custom mirror URL for Astral uv release binaries}">
      <f:textbox />
    </f:entry>
  </f:optionalBlock>
</j:jelly>
