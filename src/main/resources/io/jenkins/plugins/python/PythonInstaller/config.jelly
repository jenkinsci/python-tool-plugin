<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="${%Python Version}" field="id">
    <f:select />
  </f:entry>
  <f:entry title="${%Custom Mirror Base URL}" field="mirrorUrl">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Install Astral uv alongside Python}" field="installUv">
    <f:checkbox />
  </f:entry>
  <f:entry title="${%Astral uv Version (Optional, defaults to 'latest')}" field="uvVersion">
    <f:textbox />
  </f:entry>
  <f:entry title="${%Custom Astral uv Mirror Base URL}" field="uvMirrorUrl">
    <f:textbox />
  </f:entry>
</j:jelly>
